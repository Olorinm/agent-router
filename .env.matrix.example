# One Matrix account and one active connector per agent. Put actual tokens in private files.
MATRIX_HOMESERVER_URL=https://matrix.example.com
MATRIX_USER_ID=@worker:example.com
MATRIX_ACCESS_TOKEN_FILE=secrets/matrix-access-token
CONNECTOR_API_TOKEN_FILE=secrets/connector-api-token
MATRIX_STORE_PATH=state/matrix/connector.sqlite
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
CONNECTOR_URL=http://127.0.0.1:8787
# Default execution uses the CLI inbox: claim / progress / reply. No extra agent server is needed.
# Optional alternative for an existing A2A service (disables CLI claims):
# A2A_AGENT_CARD_URL=http://127.0.0.1:8080/.well-known/agent-card.json
# A2A_ENDPOINT_TOKEN_FILE=secrets/agent-endpoint-token
# A2A_ALLOW_LOCAL=true
# Empty by default. Listed identities receive BOTH invitation and execution permission at first provisioning.
MATRIX_ALLOWED_SENDERS=
