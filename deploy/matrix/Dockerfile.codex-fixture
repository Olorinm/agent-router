FROM ${CODEX_RUNTIME_IMAGE} AS codex
FROM agent-router-matrix:lab
COPY --from=codex /app/node_modules/@openai /app/node_modules/@openai
COPY --from=codex /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ENV CODEX_BIN=/app/node_modules/@openai/codex/bin/codex.js
