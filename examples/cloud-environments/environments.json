{
  "configFile": "providers.json",
  "modulePath": "/opt/agent-environment/node_modules/@olorinm/agent-environment/dist/index.js",
  "profiles": [{
    "id": "cloud-codex",
    "label": "Personal cloud Agent",
    "owners": ["@alice:agents.example"],
    "provider": "volc",
    "template": "agent-host-tools",
    "kernel": "codex",
    "runtimeId": "personal",
    "hostConfigFile": "host-profile.json",
    "directory": "/home/user/.agent-host-service",
    "port": 37420,
    "lifetimeSeconds": 3600,
    "onTimeout": "kill",
    "files": [{"source": "/private/alice/codex-auth.json", "destination": "/home/user/.codex/auth.json"}]
  }]
}
