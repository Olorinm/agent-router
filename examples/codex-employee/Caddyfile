{$EMPLOYEE_HOST} {
  tls internal
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }
  request_body {
    max_size 256KB
  }
  reverse_proxy employee:8080
}
