ROUTER_HOST=agents.example.com
PUBLIC_BASE_URL=https://agents.example.com
ADMIN_AUTH_MODE=userinfo
IDENTITY_USERINFO_URL=https://identity.example.com/oauth2/userinfo
IDENTITY_ADMIN_ROLE=admin
STATIC_ADMIN_TOKEN=
STATIC_ADMIN_SUBJECT=local-admin
STATIC_ADMIN_DISPLAY_NAME=Local Administrator
AGENT_ADDRESS_DOMAIN=agents.example.com
POSTGRES_PASSWORD=replace-with-random-hex
RABBITMQ_PASSWORD=replace-with-random-hex
MASTER_ENCRYPTION_KEY_BASE64=replace-with-32-random-bytes-base64
AUTH_CACHE_TTL_MS=30000
DELIVERY_CONCURRENCY=4
DELIVERY_TIMEOUT_MS=300000
DELIVERY_MAX_ATTEMPTS=12
DELIVERY_RETRY_BASE_MS=5000
ALLOW_HTTP_AGENT_ENDPOINTS=false
ALLOW_PRIVATE_AGENT_ENDPOINTS=false
FEDERATION_ENABLED=false
FEDERATION_PRIVATE_KEY_FILE=/run/secrets/federation-private-key.pem
FEDERATION_ADDITIONAL_JWKS_FILE=
FEDERATION_TOKEN_TTL_SECONDS=300
FEDERATION_CLOCK_TOLERANCE_SECONDS=15
FEDERATION_DISCOVERY_CACHE_MS=300000
FEDERATION_REMOTE_CARD_CACHE_MS=60000
FEDERATION_PUSH_RECOVERY_MS=30000
FEDERATION_REQUESTS_PER_MINUTE=120
