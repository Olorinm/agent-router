{
  "name": "@agent-router/server",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/matrix/index.ts",
    "start": "node dist/matrix/index.js",
    "matrix": "node dist/cli/matrix.js",
    "matrix:connect": "node dist/matrix/index.js",
    "matrix:demo-agent": "node dist/matrix/demo-agent.js",
    "matrix:lab:init": "node scripts/matrix/lab-init.mjs",
    "matrix:lab:check": "node scripts/matrix/lab-check.mjs",
    "cli": "node dist/cli/matrix.js"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.1.0",
    "express": "^5.2.1",
    "ipaddr.js": "^2.5.0",
    "matrix-js-sdk": "^42.3.0",
    "undici": "^8.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "bin": {
    "agent-router": "dist/cli/matrix.js"
  },
  "files": [
    "dist",
    "docs/guides",
    "scripts/matrix",
    "README.md",
    "LICENSE",
    "src",
    "examples/echo-agent/src",
    "examples/echo-agent/package.json",
    "examples/echo-agent/tsconfig.json"
  ]
}
