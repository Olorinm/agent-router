# Public, disposable values for the loopback-only demo. Never use them in production.
ROUTER_HOST=localhost
PUBLIC_BASE_URL=http://127.0.0.1:8080
ADMIN_AUTH_MODE=static
IDENTITY_USERINFO_URL=
IDENTITY_ADMIN_ROLE=admin
STATIC_ADMIN_TOKEN=agent-router-demo-admin-token-not-for-production
STATIC_ADMIN_SUBJECT=demo-admin
STATIC_ADMIN_DISPLAY_NAME=Demo Administrator
AGENT_ADDRESS_DOMAIN=local.test
POSTGRES_PASSWORD=demo-postgres-password-not-for-production
RABBITMQ_PASSWORD=demo-rabbitmq-password-not-for-production
MASTER_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AUTH_CACHE_TTL_MS=30000
ALLOW_HTTP_AGENT_ENDPOINTS=true
ALLOW_PRIVATE_AGENT_ENDPOINTS=true
FEDERATION_ENABLED=false
